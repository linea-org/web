NEXT_PUBLIC_SITE_URL=https://www.getlinea.app

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GA_ID=

# Sanity project
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Editor token, only used by `pnpm import:blog` (never needed by the site)
SANITY_WRITE_TOKEN=
