NEXT_PUBLIC_SITE_URL=https://www.getlinea.app

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GA_ID=

# Sanity project
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Editor token, only used by `pnpm import:blog` (never needed by the site)
SANITY_WRITE_TOKEN=

# Newsletter signups become Resend contacts. Needs a full-access key: a
# sending-only key is rejected by the contacts API. Without it, production
# shows "Signups are not open yet" instead of dropping addresses.
RESEND_API_KEY=
# Optional: segment the newsletter Broadcast targets (Resend > Audience > Segments).
RESEND_NEWSLETTER_SEGMENT_ID=
